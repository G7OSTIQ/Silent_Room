VisualElement {}

#PromptRoot {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    justify-content: center;
    align-items: center;
}

#Crosshair {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.7);
}

#PromptLabel {
    position: absolute;
    top: 55%;

    padding: 6px 14px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.6);

    color: rgb(230, 230, 230);
    font-size: 22px;
    -unity-text-align: middle-center;
}